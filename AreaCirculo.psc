Algoritmo AreaCirculo
    Definir radio, acirl, piVal Como Real
    piVal <- 3.1416
    Escribir "Ingrese el radio del círculo:"
    Leer radio
    
    acirl <- piVal * (radio * radio)
    
    Escribir "--- RESULTADOS ---"
    Escribir "Radio: ", radio
    Escribir "Valor de Pi utilizado: ", piVal
    Escribir "El área del círculo es: ", acirl
FinAlgoritmo