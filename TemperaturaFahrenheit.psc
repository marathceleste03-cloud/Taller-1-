Algoritmo TemperaturaFahrenheit
    Definir gc, gf Como Real
    Escribir "Ingrese la temperatura en grados Centígrados (GC):"
    Leer gc
    
    gf <- (gc * 9 / 5) + 32
    
    Escribir "--- RESULTADOS ---"
    Escribir "Temperatura en Centígrados: ", gc, " °C"
    Escribir "Temperatura convertida en Fahrenheit: ", gf, " °F"
FinAlgoritmo
