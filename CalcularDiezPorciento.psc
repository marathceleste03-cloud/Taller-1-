Algoritmo CalcularDiezPorciento
    Definir valor, resultado Como Real
    Escribir "Ingrese el valor al cual le calculará el 10%:"
    Leer valor
    
    resultado <- valor * 0.10
    
    Escribir "--- RESULTADOS ---"
    Escribir "Valor ingresado: ", valor
    Escribir "El 10% de dicho valor es: ", resultado
FinAlgoritmo
