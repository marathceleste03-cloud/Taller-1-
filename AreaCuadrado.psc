Algoritmo AreaCuadrado
    Definir lado, ac Como Real
    Escribir "Ingrese la longitud del lado del cuadrado:"
    Leer lado
    
    ac <- lado * lado
    
    Escribir "--- RESULTADOS ---"
    Escribir "Longitud del lado: ", lado
    Escribir "El área del cuadrado es: ", ac
FinAlgoritmo
