Algoritmo SumarTresValores
    Definir num1, num2, num3, suma Como Real
    Escribir "Ingrese el primer valor:"
    Leer num1
    Escribir "Ingrese el segundo valor:"
    Leer num2
    Escribir "Ingrese el tercer valor:"
    Leer num3
    
    suma <- num1 + num2 + num3
    
    Escribir "--- RESULTADOS ---"
    Escribir "Valor 1: ", num1
    Escribir "Valor 2: ", num2
    Escribir "Valor 3: ", num3
    Escribir "La suma total es: ", suma
FinAlgoritmo
